/*
  Cache-Control: public, max-age=0, must-revalidate
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' __CSP_SCRIPT_HASHES__ https://static.cloudflareinsights.com/beacon.min.js; script-src-attr 'none'; style-src 'self' __CSP_STYLE_HASHES__; style-src-attr 'none'; font-src 'self' data:; img-src 'self' data: blob:; media-src 'self'; connect-src 'self' https://cloudflareinsights.com; frame-src https://www.youtube-nocookie.com https://drive.google.com; worker-src 'self'; manifest-src 'self'; upgrade-insecure-requests; block-all-mixed-content
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Origin-Agent-Cluster: ?1
  X-Permitted-Cross-Domain-Policies: none

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
/posters/*
/icons/*
/videos/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
